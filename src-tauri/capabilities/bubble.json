{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "bubble",
  "description": "The bubble and the expanded chat window",
  "windows": [
    "bubble",
    "chat"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
