{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cursora",
  "version": "0.3.0",
  "identifier": "com.cursora.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: snip: http://snip.localhost; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": { "recommends": ["wl-clipboard"] }
    },
    "targets": ["msi", "deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2REI5RjU2MzBEQTFGRTAKUldUZ0g5b3dWcC9iQmpmeXEwdmUydHZQNXJZb0dDVWhvRzZxenB1Y204TDlGc0IrTUl6OFFPVmgK",
      "endpoints": ["https://github.com/priyansh1210/cursora-releases/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
